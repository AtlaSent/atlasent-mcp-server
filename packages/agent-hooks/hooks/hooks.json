{
  "description": "AtlaSent guard: destructive and shipping actions wait for a person",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
