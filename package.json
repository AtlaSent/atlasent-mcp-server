{
  "name": "@atlasent/mcp-server",
  "version": "2.16.0",
  "description": "AtlaSent MCP server: with an API key, an AI agent's consequential actions wait for organizational approval and get signed proof your auditor can check. Without a key it runs an offline, unsigned demo.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atlasent-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/actionRetrieval.test.ts src/server.test.ts src/awaitApproval.test.ts src/planMismatch.test.ts src/agentSession.test.ts src/mode.test.ts src/server.verify-before-execute.test.ts src/v2Client.test.ts src/v2Tools.test.ts src/complianceTools.test.ts src/vqpTools.test.ts src/evidenceGap.test.ts src/distribution.test.ts src/streamableHttp.integration.test.ts",
    "test:integration": "node --import tsx --test src/integration.test.ts src/integration.write.test.ts",
    "demo": "node examples/demo.mjs",
    "bundle": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlasent/atlasent-mcp-server.git"
  },
  "homepage": "https://github.com/Atlasent/atlasent-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Atlasent/atlasent-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "atlasent",
    "authorization",
    "policy",
    "agent",
    "ai",
    "claude",
    "cursor",
    "windsurf",
    "guardrails",
    "ai-agent-security",
    "execution-boundary",
    "permits",
    "mcp-server"
  ],
  "license": "Apache-2.0",
  "mcpName": "io.github.Atlasent/mcp-server"
}
